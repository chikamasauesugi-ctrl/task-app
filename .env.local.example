# Supabase プロジェクトの「Project Settings → API」からコピーして
# このファイルを .env.local という名前に複製して値を入れる
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Googleカレンダー常時連携用（サーバー側のみで使用。NEXT_PUBLIC を付けない）
# Supabase の Google プロバイダに登録したものと同じクライアントID・シークレット
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
